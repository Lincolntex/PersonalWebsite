---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
import { interestSections } from "../data/interests";
import aboutHero from "../assets/images/about-hero.jpg";
---

<BaseLayout
  title={`About | ${siteConfig.name}`}
  description="Hobbies and interests of Chasen Young."
>
  <section class="relative isolate overflow-hidden bg-white pt-28 pb-16 sm:pt-32 md:pt-40">
    <div
      class="absolute inset-0 -z-10"
      style={`background: radial-gradient(ellipse 900px 700px at 100% 0%, ${siteConfig.accentColor}25 0%, ${siteConfig.accentColor}10 35%, white 75%)`}
    >
    </div>

    <div
      class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 md:grid-cols-2 lg:gap-16 lg:px-8"
    >
      <div>
        <h1
          class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl"
        >
          About Me
        </h1>
        <div
          class="mt-3 h-[5px] w-[75px] rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
        <p class="mt-8 text-lg leading-relaxed text-gray-600 sm:text-xl">
          {siteConfig.aboutMe}
        </p>
        <p class="mt-4 text-base leading-relaxed text-gray-600 sm:text-lg">
          Outside of work and school, I enjoy playing music, getting outdoors,
          tinkering with technology, and exploring tabletop games.
        </p>
      </div>

      <div class="flex justify-center lg:justify-end">
        <Image
          src={aboutHero}
          alt="Chasen Young"
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 32vw, 70vw"
          class="h-auto w-56 rounded-2xl object-cover shadow-xl sm:w-72 lg:w-full lg:max-w-md"
        />
      </div>
    </div>
  </section>

  <section class="px-6 pb-24 sm:px-12 lg:px-8">
    <div class="mx-auto max-w-6xl">
      {
        interestSections.map((section) => (
          <div class="mb-20 last:mb-0">
            <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl">
              {section.title}
            </h2>
            <div
              class="mt-2 h-[5px] w-[75px] rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />

            <div class="mt-8 space-y-8">
              {section.items.map((item) => (
                <article class="grid grid-cols-1 items-center gap-6 rounded-2xl border border-gray-200 bg-gray-50 p-4 transition-shadow duration-300 hover:shadow-lg sm:p-6 md:grid-cols-2 md:gap-10">
                  <Image
                    src={item.image}
                    alt={item.alt}
                    widths={[400, 640, 800]}
                    sizes="(min-width: 768px) 45vw, 90vw"
                    class="h-64 w-full rounded-xl object-cover sm:h-80"
                  />
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 sm:text-2xl">
                      {item.heading}
                    </h3>
                    <p class="mt-3 text-base leading-relaxed text-gray-600">
                      {item.content}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
