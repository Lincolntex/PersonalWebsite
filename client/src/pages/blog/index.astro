---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../config";
import { withBase } from "../../utils/with-base";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title={`Blog | ${siteConfig.name}`}
  description="Notes and articles by Chasen Young."
>
  <section class="px-6 pt-28 pb-24 sm:px-12 sm:pt-32 md:pt-40 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
        Blog
      </h1>
      <div
        class="mt-3 h-[5px] w-[75px] rounded-full"
        style={`background-color: ${siteConfig.accentColor}`}
      >
      </div>

      {
        posts.length === 0 ? (
          <div class="mt-12 rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center sm:p-12">
            <p class="text-lg text-gray-600">
              No posts yet. Check back soon!
            </p>
          </div>
        ) : (
          <ul class="mt-12 space-y-6">
            {posts.map((post) => (
              <li>
                <a
                  href={withBase(`/blog/${post.id}/`)}
                  class="block rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
                >
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <h2 class="text-xl font-bold text-gray-900 sm:text-2xl">
                      {post.data.title}
                    </h2>
                    {post.data.topic && (
                      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600">
                        {post.data.topic}
                      </span>
                    )}
                  </div>
                  {post.data.description && (
                    <p class="mt-2 text-gray-600">{post.data.description}</p>
                  )}
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="mt-3 block text-sm text-gray-500"
                  >
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
